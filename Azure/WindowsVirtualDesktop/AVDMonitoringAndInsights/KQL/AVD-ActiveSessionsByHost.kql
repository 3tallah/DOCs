// Active session density by discovered session host.
let Lookback = 24h;
let BinSize = 5m;
union isfuzzy=true
 (datatable(TimeGenerated:datetime, Computer:string, ObjectName:string, CounterName:string, CounterValue:real)[]), Perf
| where TimeGenerated > ago(Lookback)
| where ObjectName =~ "Terminal Services"
| where CounterName =~ "Active Sessions"
| summarize ActiveSessions=max(CounterValue) by bin(TimeGenerated, BinSize), Computer
| order by TimeGenerated asc
| render timechart with (title="AVD Active Sessions per Host", ytitle="Active Sessions")
