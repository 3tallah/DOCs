// Per-session user input delay by discovered session host.
let Lookback = 24h;
let BinSize = 5m;
union isfuzzy=true
 (datatable(TimeGenerated:datetime, Computer:string, ObjectName:string, CounterName:string, CounterValue:real)[]), Perf
| where TimeGenerated > ago(Lookback)
| where ObjectName =~ "User Input Delay per Session"
| where CounterName =~ "Max Input Delay"
| summarize AvgInputDelayMs=avg(CounterValue), MaxInputDelayMs=max(CounterValue) by bin(TimeGenerated, BinSize), Computer
| order by TimeGenerated asc
| render timechart with (title="AVD User Input Delay", ytitle="Input Delay (ms)")
