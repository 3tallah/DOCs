// Memory utilization by discovered session host.
let Lookback = 24h;
let BinSize = 5m;
union isfuzzy=true
 (datatable(TimeGenerated:datetime, Computer:string, ObjectName:string, CounterName:string, CounterValue:real)[]), Perf
| where TimeGenerated > ago(Lookback)
| where ObjectName =~ "Memory"
| where CounterName =~ "% Committed Bytes In Use"
| summarize AvgMemory=avg(CounterValue), MaxMemory=max(CounterValue) by bin(TimeGenerated, BinSize), Computer
| order by TimeGenerated asc
| render timechart with (title="AVD Session Host Memory", ytitle="Memory Used (%)")
